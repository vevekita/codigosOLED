void setup() {
  Serial.begin(9600);

  if (!display.begin(SSD1306_SWITCHCAPVCC, SCREEN_ADDRESS)) {
    Serial.println(F("Falha ao iniciar o display SSD1306"));
    for (;;); // trava aqui se o display nao for encontrado
  }

  desenharLogo();
}

void loop() {
  // nada aqui, a logo fica estatica na tela
}

void desenharLogo() {
  display.clearDisplay();

  // Icone (circuito) centralizado na parte de cima
  int iconX = (SCREEN_WIDTH - LOGO_WIDTH) / 2;
  int iconY = 0;
  display.drawBitmap(iconX, iconY, logo_bitmap, LOGO_WIDTH, LOGO_HEIGHT, SSD1306_WHITE);

  // Texto "CONECTADAS" logo abaixo, usando a fonte nativa (mais nitido que bitmap pequeno)
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);

  int16_t x1, y1;
  uint16_t textW, textH;
  display.getTextBounds("CONECTADAS", 0, 0, &x1, &y1, &textW, &textH);
  int textX = (SCREEN_WIDTH - textW) / 2;
  int textY = LOGO_HEIGHT + 4;

  display.setCursor(textX, textY);
  display.print("CONECTADAS");

  display.display();
}
