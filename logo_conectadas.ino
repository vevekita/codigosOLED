/*
  Logo CONECTADAS - OLED 0.96" I2C (SSD1306 128x64)
  ---------------------------------------------------
  Bibliotecas necessarias (Gerenciador de Bibliotecas do Arduino IDE):
    - Adafruit GFX Library
    - Adafruit SSD1306

  Ligacoes tipicas (Arduino Uno/Nano):
    OLED VCC -> 5V (ou 3.3V, depende do modulo)
    OLED GND -> GND
    OLED SDA -> A4
    OLED SCL -> A5

  Se o display nao aparecer, confirme o endereco I2C (0x3C e o mais comum,
  alguns modulos usam 0x3D) rodando um "I2C Scanner" antes.
*/

#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>

#define SCREEN_WIDTH  128
#define SCREEN_HEIGHT 64
#define OLED_RESET    -1
#define SCREEN_ADDRESS 0x3C

Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, OLED_RESET);

